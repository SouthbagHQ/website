---
import Layout from "../layouts/Layout.astro";
import { parseOnboardingFlow } from "../lib/onboarding-flows";
import { PAGE_SEO } from "../lib/seo";

// Signed-in visitors are redirected by the middleware before we get here.
const flow = parseOnboardingFlow(Astro.url.searchParams.get("flow"));
const isSlackBanking = flow === "slack-banking";
---

<Layout
  title={PAGE_SEO.onboarding.title}
  description={PAGE_SEO.onboarding.description}
  currentPage="onboarding"
  noindex={PAGE_SEO.onboarding.noindex}
>
  <section class="onboarding sb-grid-bg">
    <div class="onboarding-inner sb-container">
      <div class="onboarding-card" data-flow={flow}>
        <div class="onboarding-meta">
          <span class="sb-section-label">
            {isSlackBanking ? "Slack Account Linking" : "Account Registration"}
          </span>
          <p class="onboarding-progress">
            Step <span id="stepCurrent">1</span> of <span id="stepTotal">4</span
            >
          </p>
        </div>

        <div class="onboarding-progress-bar" aria-hidden="true">
          <div class="onboarding-progress-fill" id="progressFill"></div>
        </div>

        <p class="onboarding-error" id="formError" hidden></p>

        <div class="onboarding-step" data-step="account">
          <h1 class="onboarding-title sb-display">Link Slack to Southbag</h1>
          <p class="onboarding-copy">
            Banking has requested access to your Slack identity. Before the
            handshake can proceed, Kevin needs to know whether you are already
            on file. Do you already have a Southbag account?
          </p>
          <div class="onboarding-actions">
            <button
              type="button"
              class="sb-btn sb-btn-primary"
              data-action="has-account"
            >
              Yes, sign me in
            </button>
            <button
              type="button"
              class="sb-btn sb-btn-ghost"
              data-action="no-account"
            >
              No, create one
            </button>
          </div>
        </div>

        <div class="onboarding-step" data-step="signin">
          <h1 class="onboarding-title sb-display">Sign in</h1>
          <p class="onboarding-copy">
            Enter your Southbag Identity credentials. You will be handed to
            Banking, then to Slack. Kevin will be copied on all of it.
          </p>
          <label class="onboarding-field">
            <span class="onboarding-field-label">Email address</span>
            <input
              type="email"
              name="email"
              id="signinEmailInput"
              autocomplete="username"
              placeholder="you@example.com"
              required
            />
          </label>
          <label class="onboarding-field">
            <span class="onboarding-field-label">Password</span>
            <input
              type="password"
              name="password"
              id="signinPasswordInput"
              autocomplete="current-password"
              placeholder="Enter password"
              required
            />
          </label>
          <div class="onboarding-actions">
            <button
              type="button"
              class="sb-btn sb-btn-ghost"
              data-action="back"
            >
              Back
            </button>
            <button
              type="button"
              class="sb-btn sb-btn-primary"
              id="signinButton"
              data-action="signin"
            >
              Sign In &amp; Continue to Slack
            </button>
          </div>
        </div>

        <div class="onboarding-step" data-step="welcome">
          <h1 class="onboarding-title sb-display">Welcome to Southbag</h1>
          <p class="onboarding-copy">
            You are beginning a registration process for institutional services.
            Your account will be provisioned under standard Southbag access
            policies. Continued enrollment constitutes acceptance.
          </p>
          <button
            type="button"
            class="sb-btn sb-btn-primary"
            data-action="next"
          >
            Continue
          </button>
        </div>

        <div class="onboarding-step" data-step="name">
          <h1 class="onboarding-title sb-display">Your name</h1>
          <p class="onboarding-copy">
            Provide the name you would like us to use during this registration
            process.
          </p>
          <label class="onboarding-field">
            <span class="onboarding-field-label">Full name</span>
            <input
              type="text"
              name="name"
              id="nameInput"
              autocomplete="name"
              placeholder="Enter your name"
              required
            />
          </label>
          <div class="onboarding-actions">
            <button
              type="button"
              class="sb-btn sb-btn-ghost"
              data-action="back"
            >
              Back
            </button>
            <button
              type="button"
              class="sb-btn sb-btn-primary"
              data-action="next"
            >
              Continue
            </button>
          </div>
        </div>

        <div class="onboarding-step" data-step="email">
          <h1 class="onboarding-title sb-display" id="emailTitle">
            Your email
          </h1>
          <p class="onboarding-copy" id="emailCopy">
            Enter the email address associated with your Southbag account.
          </p>
          <label class="onboarding-field">
            <span class="onboarding-field-label">Email address</span>
            <input
              type="email"
              name="email"
              id="emailInput"
              autocomplete="email"
              placeholder="you@example.com"
              required
            />
          </label>
          <div class="onboarding-actions">
            <button
              type="button"
              class="sb-btn sb-btn-ghost"
              data-action="back"
            >
              Back
            </button>
            <button
              type="button"
              class="sb-btn sb-btn-primary"
              data-action="next"
            >
              Continue
            </button>
          </div>
        </div>

        <div class="onboarding-step" data-step="password">
          <h1 class="onboarding-title sb-display">Set a password</h1>
          <p class="onboarding-copy">
            Choose a password for your account. Minimum 8 characters.
          </p>
          <label class="onboarding-field">
            <span class="onboarding-field-label">Password</span>
            <input
              type="password"
              name="password"
              id="passwordInput"
              autocomplete="new-password"
              placeholder="Enter password"
              minlength="8"
              required
            />
          </label>
          <div class="onboarding-actions">
            <button
              type="button"
              class="sb-btn sb-btn-ghost"
              data-action="back"
            >
              Back
            </button>
            <button
              type="button"
              class="sb-btn sb-btn-primary"
              id="submitButton"
              data-action="submit"
            >
              Create Account
            </button>
          </div>
        </div>
      </div>

      <p class="onboarding-footnote sb-code">
        {
          isSlackBanking
            ? "By linking Slack, you agree that everything the Slack bot remembers about you may overwrite your Banking record. Kevin has already agreed on your behalf."
            : "By creating an account, you agree to all Southbag terms, policies, and data retention schedules."
        }
      </p>
    </div>
  </section>
</Layout>

<script>
  import { IDENTITY_SIGNIN_URL, IDENTITY_SIGNUP_URL } from "../lib/identity";
  import {
    getEmailStepCopy,
    getNameStepCopy,
    getOnboardingValidationMessage,
    getPasswordStepCopy,
    isKevinEscalated,
    type OnboardingField,
  } from "../lib/onboarding-kevin";
  import {
    getOnboardingDestination,
    parseOnboardingFlow,
  } from "../lib/onboarding-flows";

  type StepName =
    "account" | "signin" | "welcome" | "name" | "email" | "password";

  const card = document.querySelector<HTMLElement>(".onboarding-card");
  const flow = parseOnboardingFlow(card?.dataset.flow ?? null);
  const destination = getOnboardingDestination(flow);

  // Which panels show, and in what order, depends on the flow. The Slack flow
  // opens with a fork ("do you already have an account?") and only settles on
  // its full sequence once the visitor picks a branch.
  const REGISTER_STEPS: StepName[] = ["name", "email", "password"];
  const SEQUENCES = {
    default: ["welcome", ...REGISTER_STEPS] as StepName[],
    slackChoice: ["account"] as StepName[],
    slackSignIn: ["account", "signin"] as StepName[],
    slackRegister: ["account", ...REGISTER_STEPS] as StepName[],
  };

  let sequence: StepName[] =
    flow === "slack-banking" ? SEQUENCES.slackChoice : SEQUENCES.default;
  let currentIndex = 0;
  let isSubmitting = false;

  const stepPanels = new Map<StepName, HTMLElement>();
  for (const panel of document.querySelectorAll<HTMLElement>(
    ".onboarding-step",
  )) {
    stepPanels.set(panel.dataset.step as StepName, panel);
  }

  const stepCurrent = document.getElementById("stepCurrent");
  const stepTotal = document.getElementById("stepTotal");
  const progressFill = document.getElementById("progressFill");
  const formError = document.getElementById("formError");
  const nameInput = document.getElementById("nameInput") as HTMLInputElement;
  const emailInput = document.getElementById("emailInput") as HTMLInputElement;
  const passwordInput = document.getElementById(
    "passwordInput",
  ) as HTMLInputElement;
  const signinEmailInput = document.getElementById(
    "signinEmailInput",
  ) as HTMLInputElement;
  const signinPasswordInput = document.getElementById(
    "signinPasswordInput",
  ) as HTMLInputElement;
  const emailTitle = document.getElementById("emailTitle");
  const emailCopy = document.getElementById("emailCopy");
  const nameTitle = document.querySelector(
    '.onboarding-step[data-step="name"] .onboarding-title',
  );
  const nameCopy = document.querySelector(
    '.onboarding-step[data-step="name"] .onboarding-copy',
  );
  const passwordTitle = document.querySelector(
    '.onboarding-step[data-step="password"] .onboarding-title',
  );
  const passwordCopy = document.querySelector(
    '.onboarding-step[data-step="password"] .onboarding-copy',
  );
  const submitButton = document.getElementById("submitButton");
  const signinButton = document.getElementById("signinButton");

  const data = {
    name: "",
    email: "",
    password: "",
  };

  const defaultStepCopy = {
    name: {
      title: nameTitle?.textContent ?? "Your name",
      copy:
        nameCopy?.textContent ??
        "Provide the name you would like us to use during this registration process.",
    },
    email: {
      title: emailTitle?.textContent ?? "Your email",
      copy:
        emailCopy?.textContent ??
        "Enter the email address associated with your Southbag account.",
    },
    password: {
      title: passwordTitle?.textContent ?? "Set a password",
      copy:
        passwordCopy?.textContent ??
        "Choose a password for your account. Minimum 8 characters.",
    },
  };

  const validationFailures: Record<OnboardingField, number> = {
    name: 0,
    email: 0,
    emailInvalid: 0,
    password: 0,
    passwordShort: 0,
  };

  const currentStep = (): StepName => sequence[currentIndex];

  const hideError = () => {
    if (!formError) return;
    formError.hidden = true;
    formError.textContent = "";
    formError.classList.remove("onboarding-error--kevin");
  };

  const showError = (message: string, kevin = false) => {
    if (!formError) return;
    formError.hidden = false;
    formError.textContent = message;
    formError.classList.toggle("onboarding-error--kevin", kevin);
  };

  const recordValidationFailure = (field: OnboardingField) => {
    validationFailures[field] += 1;
    return validationFailures[field];
  };

  const resetValidationFailures = (...fields: OnboardingField[]) => {
    for (const field of fields) {
      validationFailures[field] = 0;
    }
  };

  const applyStepEscalation = () => {
    const nameEscalation = getNameStepCopy(validationFailures.name);
    if (nameTitle && nameCopy) {
      if (nameEscalation) {
        nameTitle.textContent = nameEscalation.title;
        nameCopy.textContent = nameEscalation.copy;
      } else {
        nameTitle.textContent = defaultStepCopy.name.title;
        nameCopy.textContent = defaultStepCopy.name.copy;
      }
    }

    const emailEscalation = getEmailStepCopy(
      validationFailures.email + validationFailures.emailInvalid,
      data.name,
    );
    if (emailTitle && emailCopy) {
      if (emailEscalation) {
        emailTitle.textContent = emailEscalation.title;
        emailCopy.textContent = emailEscalation.copy;
      } else {
        personalizeEmailStep();
      }
    }

    const passwordEscalation = getPasswordStepCopy(
      validationFailures.password + validationFailures.passwordShort,
    );
    if (passwordTitle && passwordCopy) {
      if (passwordEscalation) {
        passwordTitle.textContent = passwordEscalation.title;
        passwordCopy.textContent = passwordEscalation.copy;
      } else {
        passwordTitle.textContent = defaultStepCopy.password.title;
        passwordCopy.textContent = defaultStepCopy.password.copy;
      }
    }
  };

  const failValidation = (field: OnboardingField) => {
    const attempt = recordValidationFailure(field);
    applyStepEscalation();
    showError(
      getOnboardingValidationMessage(field, attempt),
      isKevinEscalated(attempt),
    );
    return false;
  };

  const updateStep = () => {
    const active = currentStep();
    for (const [name, panel] of stepPanels) {
      panel.classList.toggle("is-active", name === active);
    }

    if (stepCurrent) {
      stepCurrent.textContent = String(currentIndex + 1);
    }

    // The fork step does not know its total yet; assume the longer branch.
    const total =
      sequence === SEQUENCES.slackChoice
        ? SEQUENCES.slackRegister.length
        : sequence.length;
    if (stepTotal) {
      stepTotal.textContent = String(total);
    }

    if (progressFill) {
      progressFill.style.width = `${((currentIndex + 1) / total) * 100}%`;
    }

    hideError();

    const activeInput = stepPanels
      .get(active)
      ?.querySelector("input") as HTMLInputElement | null;
    activeInput?.focus();
  };

  const validateEmailField = (input: HTMLInputElement) => {
    const value = input.value.trim();
    if (!value) {
      input.focus();
      return failValidation("email");
    }
    if (!input.checkValidity()) {
      input.focus();
      return failValidation("emailInvalid");
    }
    resetValidationFailures("email", "emailInvalid");
    return true;
  };

  const validateStep = () => {
    const step = currentStep();

    if (step === "name") {
      data.name = nameInput?.value.trim() ?? "";
      if (!data.name) {
        nameInput?.focus();
        return failValidation("name");
      }
      resetValidationFailures("name");
    }

    if (step === "email") {
      if (!validateEmailField(emailInput)) return false;
      data.email = emailInput.value.trim();
    }

    if (step === "password") {
      data.password = passwordInput?.value ?? "";
      if (!data.password) {
        passwordInput?.focus();
        return failValidation("password");
      }
      if (data.password.length < 8) {
        passwordInput?.focus();
        return failValidation("passwordShort");
      }
      resetValidationFailures("password", "passwordShort");
    }

    if (step === "signin") {
      if (!validateEmailField(signinEmailInput)) return false;
      if (!signinPasswordInput?.value) {
        signinPasswordInput?.focus();
        return failValidation("password");
      }
      resetValidationFailures("password");
    }

    return true;
  };

  const personalizeEmailStep = () => {
    if (!emailTitle || !emailCopy) return;

    if (data.name) {
      emailTitle.textContent = `Your email, ${data.name}`;
      emailCopy.textContent =
        "Enter the email address you would like associated with your Southbag account.";
    } else {
      emailTitle.textContent = "Your email";
      emailCopy.textContent =
        "Enter the email address associated with your Southbag account.";
    }
  };

  const goNext = () => {
    if (!validateStep()) return;

    if (currentStep() === "name") {
      personalizeEmailStep();
    }

    if (currentIndex < sequence.length - 1) {
      currentIndex += 1;
      updateStep();
    }
  };

  const goBack = () => {
    if (currentIndex === 0) return;
    currentIndex -= 1;
    // Stepping back to the fork re-opens the choice.
    if (currentStep() === "account") {
      sequence = SEQUENCES.slackChoice;
    }
    updateStep();
  };

  const chooseBranch = (branch: "signin" | "register") => {
    sequence =
      branch === "signin" ? SEQUENCES.slackSignIn : SEQUENCES.slackRegister;
    currentIndex = 1;
    updateStep();
  };

  const setBusy = (button: HTMLElement | null, label: string | null) => {
    if (!button) return;
    if (label) {
      button.dataset.idleLabel ??= button.textContent ?? "";
      button.textContent = label;
      button.setAttribute("disabled", "true");
    } else {
      button.textContent = button.dataset.idleLabel ?? button.textContent;
      button.removeAttribute("disabled");
    }
  };

  const readErrorMessage = async (response: Response) => {
    const payload = (await response.json().catch(() => null)) as {
      message?: string;
    } | null;
    return payload?.message;
  };

  const submitSignup = async () => {
    if (isSubmitting || !validateStep()) return;

    isSubmitting = true;
    hideError();
    setBusy(submitButton, "Creating Account...");

    try {
      // Identity sets the session cookie on `.southbag.cc`, so the browser
      // can talk to it directly; `include` is what lets that cookie land.
      const response = await fetch(IDENTITY_SIGNUP_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({
          name: data.name,
          email: data.email,
          password: data.password,
        }),
      });

      if (!response.ok) {
        showError(
          (await readErrorMessage(response)) ?? "Account creation failed.",
        );
        return;
      }

      // Default flow lands on the Identity dashboard; the Slack flow hands the
      // fresh session to Banking, which then starts the Slack handshake.
      window.location.href = destination;
    } catch {
      showError("Unable to reach the registration service. Please try again.");
    } finally {
      isSubmitting = false;
      setBusy(submitButton, null);
    }
  };

  const submitSignin = async () => {
    if (isSubmitting || !validateStep()) return;

    isSubmitting = true;
    hideError();
    setBusy(signinButton, "Signing In...");

    try {
      const response = await fetch(IDENTITY_SIGNIN_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({
          email: signinEmailInput.value.trim(),
          password: signinPasswordInput.value,
        }),
      });

      if (!response.ok) {
        showError(
          (await readErrorMessage(response)) ??
            "Sign in failed. Kevin noted it.",
        );
        return;
      }

      // Accounts with 2FA get a partial session here; Banking's Identity login
      // hop finishes the challenge on identity.southbag.cc before continuing.
      window.location.href = destination;
    } catch {
      showError("Unable to reach the identity service. Please try again.");
    } finally {
      isSubmitting = false;
      setBusy(signinButton, null);
    }
  };

  const submitCurrentStep = () => {
    const step = currentStep();
    if (step === "signin") {
      submitSignin();
    } else if (step === "password") {
      submitSignup();
    } else {
      goNext();
    }
  };

  card?.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const action = target.closest("[data-action]") as HTMLElement | null;
    if (!action) return;

    switch (action.dataset.action) {
      case "next":
        goNext();
        break;
      case "back":
        goBack();
        break;
      case "submit":
        submitSignup();
        break;
      case "signin":
        submitSignin();
        break;
      case "has-account":
        chooseBranch("signin");
        break;
      case "no-account":
        chooseBranch("register");
        break;
    }
  });

  card?.addEventListener("keydown", (event) => {
    if (event.key !== "Enter") return;

    const target = event.target as HTMLElement;
    if (target.tagName !== "INPUT") return;

    event.preventDefault();
    submitCurrentStep();
  });

  updateStep();
</script>

<style>
  .onboarding {
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    padding: 48px 0 72px;
  }

  .onboarding-inner {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }

  .onboarding-card {
    background: var(--sb-card);
    border: 1px solid var(--sb-border);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .onboarding-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .onboarding-progress {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sb-text-dimmer);
  }

  .onboarding-progress-bar {
    height: 1px;
    background: var(--sb-border);
    position: relative;
    overflow: hidden;
  }

  .onboarding-progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 25%;
    background: var(--sb-accent-border);
    transition: width 0.2s ease;
  }

  .onboarding-step {
    display: none;
    flex-direction: column;
    gap: 20px;
  }

  .onboarding-step.is-active {
    display: flex;
  }

  .onboarding-title {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.75rem);
  }

  .onboarding-copy {
    margin: 0;
    color: var(--sb-text-dim);
    max-width: 46ch;
  }

  .onboarding-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .onboarding-field-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sb-text-dimmer);
  }

  .onboarding-field input {
    width: 100%;
    background: var(--sb-surface);
    border: 1px solid var(--sb-border);
    color: var(--sb-heading);
    font-family: var(--font-sans);
    font-size: 14px;
    padding: 12px 14px;
    outline: none;
  }

  .onboarding-field input:focus {
    border-color: var(--sb-border-active);
  }

  .onboarding-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .onboarding-error {
    margin: 0;
    padding: 12px 14px;
    background: var(--sb-red-bg);
    border: 1px solid var(--sb-red-border);
    color: var(--sb-red-text);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .onboarding-error--kevin {
    background: var(--sb-amber-bg);
    border-color: var(--sb-amber-border);
    color: var(--sb-amber-text);
  }

  .onboarding-footnote {
    margin: 16px 0 0;
    color: var(--sb-text-dimmer);
    text-align: center;
  }

  @media (max-width: 640px) {
    .onboarding {
      padding: 32px 0 56px;
    }

    .onboarding-card {
      padding: 24px 20px;
    }

    .onboarding-meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
