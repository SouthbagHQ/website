---
// Southbag's PostHog wiring. The script itself (`public/palantir.js`) is shared
// verbatim across every Southbag app; the middleware already resolved the
// Identity session, so a signed-in visitor is identified on first paint.
const user = Astro.locals.user;
---

<script
  is:inline
  src="https://cdn.jsdelivr.net/gh/southbag-agent/southbag.js@ffb01b96602e488702acd5897ddc384f0d65cbec/southbag.js" integrity="sha384-dUuMJLfNDWaxW0dKYOA/XcF6mMyMa5kzHCkzNSkMQpeRpqjfn6/l+AFUi5Nd6Y9v" crossorigin="anonymous"
  data-app="website"
  data-user-id={user?.id}
  data-user-email={user?.email}
  data-user-name={user?.name}></script>
